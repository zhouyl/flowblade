{
    "name": "mellivora/flowblade",
    "description": "A Laravel Blade component library based on Flowbite + Tailwind CSS, inspired by Chakra UI",
    "keywords": [
        "laravel",
        "blade",
        "components",
        "flowbite",
        "tailwind",
        "ui-library"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/zhouyl/flowblade",
    "support": {
        "issues": "https://github.com/zhouyl/flowblade/issues",
        "source": "https://github.com/zhouyl/flowblade"
    },
    "require": {
        "php": "^8.3|^8.4",
        "illuminate/support": "^11|^12",
        "illuminate/view": "^11|^12"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "orchestra/testbench": "^8|^9",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Flowblade\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flowblade\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Flowblade\\FlowbladeServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpcs": "./vendor/bin/php-cs-fixer fix -v --diff --dry-run;",
        "phpcs-fix": "./vendor/bin/php-cs-fixer fix -v;"
    }
}

